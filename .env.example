# === Base de datos ===
POSTGRES_USER=erp_admin
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=erp_marketplace
DATABASE_URL=postgresql+asyncpg://erp_admin:change_me_strong_password@localhost:5432/erp_marketplace
SYNC_DATABASE_URL=postgresql://erp_admin:change_me_strong_password@localhost:5432/erp_marketplace

# === Redis / Cache / Colas ===
REDIS_URL=redis://localhost:6379/0

# === Elasticsearch ===
ELASTICSEARCH_URL=http://localhost:9200

# === Seguridad / JWT (RS256 - par de llaves asimétricas) ===
SECRET_KEY=replace_with_openssl_rand_hex_64
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# === CORS ===
CORS_ORIGINS=http://localhost:5173,http://localhost:80

# === Almacenamiento de objetos (S3 / MinIO compatible) ===
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=change_me_minio_secret
S3_BUCKET=erp-marketplace
S3_REGION=us-east-1

# === Pasarela de pagos (Stripe) — requiere llaves reales del comercio ===
STRIPE_API_KEY=sk_test_replace_with_real_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_real_secret

# === Correo / SMS / Push (proveedor real requerido) ===
SMTP_HOST=smtp.mailprovider.com
SMTP_PORT=587
SMTP_USER=notifications@tudominio.com
SMTP_PASSWORD=change_me
SMS_PROVIDER_API_KEY=replace_me
PUSH_PROVIDER_API_KEY=replace_me

# === Entorno ===
ENVIRONMENT=development
VITE_API_URL=http://localhost:8000
